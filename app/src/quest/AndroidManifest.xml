<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- OpenXR-capable VR headset (Quest). required=false keeps the APK
         installable on other devices for sideload testing. -->
    <uses-feature
        android:name="android.hardware.vr.headtracking"
        android:version="1"
        android:required="true" />
    <!-- Hand tracking is optional: the game falls back to Touch controllers
         when it is unavailable or disabled. -->
    <uses-feature
        android:name="oculus.software.handtracking"
        android:required="false" />

    <uses-permission android:name="com.oculus.permission.HAND_TRACKING" />

    <application>
        <meta-data android:name="com.oculus.supportedDevices"
                   android:value="quest|quest2|questpro|quest3|quest3s" />
        <!-- Keep 6DOF tracking + frame submission when the system VR overlay
             steals focus (avoids tracking loss inside the boundary menus). -->
        <meta-data android:name="com.oculus.vr.focusaware"
                   android:value="true" />

        <activity
            android:name="android.app.NativeActivity"
            android:screenOrientation="landscape"
            android:excludeFromRecents="true">

            <intent-filter>
                <category android:name="com.oculus.intent.category.VR" />
                <category android:name="org.khronos.openxr.intent.category.IMMERSIVE_HMD" />
            </intent-filter>
        </activity>
    </application>
</manifest>
