<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- OpenXR-capable VR headset (Quest). required=false keeps the APK
         installable on other devices for sideload testing. -->
    <uses-feature
        android:name="android.hardware.vr.headtracking"
        android:version="1"
        android:required="true" />
    <!-- Hand tracking is optional: the game falls back to Touch controllers
         when it is unavailable or disabled. -->
    <uses-feature
        android:name="oculus.software.handtracking"
        android:required="false" />

    <uses-permission android:name="com.oculus.permission.HAND_TRACKING" />
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Needed only if you want to load WADs from shared storage (/sdcard). -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />

    <application
        android:label="@string/app_name"
        android:hasCode="true"
        android:allowBackup="false"
        tools:ignore="MissingApplicationIcon">

        <meta-data android:name="com.oculus.supportedDevices"
                   android:value="quest|quest2|questpro|quest3|quest3s" />

        <activity
            android:name="android.app.NativeActivity"
            android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen"
            android:launchMode="singleTask"
            android:screenOrientation="landscape"
            android:excludeFromRecents="true"
            android:resizeableActivity="false"
            android:exported="true"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|screenLayout|smallestScreenSize|navigation|uiMode|density|fontScale">

            <meta-data android:name="android.app.lib_name"
                       android:value="questdoom" />

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="com.oculus.intent.category.VR" />
                <category android:name="org.khronos.openxr.intent.category.IMMERSIVE_HMD" />
            </intent-filter>
        </activity>
    </application>
</manifest>
